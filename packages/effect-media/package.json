{
  "name": "@thomasfosterau/effect-media",
  "version": "0.0.0",
  "description": "Images, graphics, audio and video for Effect: core data types and operations.",
  "keywords": [
    "color",
    "effect",
    "geometry",
    "image",
    "media"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-media#readme",
